# Public HTTPS URL Bolna calls back on (cloudflared tunnel URL in dev)
PUBLIC_BASE_URL=https://example.trycloudflare.com

BOLNA_API_KEY=
# Random string; Bolna sends it on lookup, tool calls and webhooks
BOLNA_TOOL_SECRET=
# From `uv run saarthi-sync --numbers`
BOLNA_PHONE_NUMBER_ID=
# Web app sign-in codes: "call" (Saarthi phones you) or "log" (printed in the API log, for dev)
WEB_LOGIN_DELIVERY=call
TELEPHONY_PROVIDER=plivo

# OpenRouter via Bolna's custom LLM provider (registered by `saarthi-sync`)
LLM_PROVIDER=custom
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_FAMILY=deepseek
# OpenRouter API key
LLM_API_KEY=
# JSON merged into every completion request: reasoning off, and pin the upstream providers
# that measured fastest for streamed tool calls (others are still allowed as fallbacks)
LLM_EXTRA_BODY={"reasoning": {"effort": "none"}, "provider": {"order": ["together", "crusoe/fp8"], "allow_fallbacks": true}}

TTS_MODEL=bulbul:v4-flash
TTS_VOICE=Aparna (Customer)
TTS_VOICE_ID=aparna_hi_customer
STT_MODEL=saaras:v4
DEFAULT_LANGUAGE=hi

SUPERMEMORY_API_KEY=

# In-call web search (Bolna built-in): openai needs no key; exa/firecrawl/parallel need one
WEB_SEARCH_PROVIDER=exa
EXA_API_KEY=

# Sandbox worker agent (Claude Agent SDK via OpenRouter); any OpenRouter model id
OPENROUTER_API_KEY=
WORKER_MODEL=deepseek/deepseek-v4.1-flash
WORKER_FAST_MODEL=deepseek/deepseek-v4.1-flash

# Local runs outside compose
DATABASE_URL=postgresql+asyncpg://saarthi:saarthi@localhost:5433/saarthi
REDIS_URL=redis://localhost:6380/0
